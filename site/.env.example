# Copy to .env and edit. Everything is optional for running locally.

# Long random string – REQUIRED in production (keeps admins logged in across restarts)
SECRET_KEY=change-me-to-a-long-random-string

# Public address of the site (used in email links)
SITE_URL=http://localhost:8000

# Database – SQLite file by default
# DATABASE_URL=sqlite:///data/jps.db

# Email. Leave SMTP_HOST empty locally: emails are printed in the terminal instead of sent.
# For Gmail: turn on 2-Step Verification, create an App Password, then:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-business-email@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# EMAIL_FROM=Just Professional Services <your-business-email@gmail.com>
# NOTIFY_EMAIL=your-business-email@gmail.com   # receives new requests

# Stripe – leave empty to keep online payments switched off
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_BRONZE=
# STRIPE_PRICE_SILVER=
# STRIPE_PRICE_GOLD=
